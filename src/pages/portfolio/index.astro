---
import Base from '../../layouts/Base.astro';
const projects=[{id:'newsroom',n:'01',category:'AI PRODUCT / COLLABORATION',name:'AI-Newsroom OS',description:'한 건의 기사를 한 번의 흐름으로. 기사 작성·검증·콘텐츠 변환·자료 보관을 통합하는 워크플로 제품.',roles:'Data Map · Integration · Project Lead',stack:'React · Node.js · AI · Data Design',href:'https://github.com/beang66/ai-newsroom-os'},{id:'art-city',n:'02',category:'DATA / INDEPENDENT PROJECT',name:'Art City Intelligence',description:'세계 도시의 문화 인프라와 기회를 비교하기 위한 지표 기반 탐색 플랫폼. 규모와 밀도를 구분해 관찰합니다.',roles:'Concept · Research · Product Design',stack:'Next.js · Data Visualization',href:'https://github.com/beang66/art-city-intelligence'},{id:'newteams',n:'03',category:'AGENT SYSTEM / R&D',name:'NewTeams',description:'기본적으로 단일 에이전트가 대응하고, 검수·분업·맥락 분리가 필요할 때 전문 에이전트로 확장하는 작업 시스템.',roles:'System Planning · Architecture',stack:'Agent Orchestration · MCP · Automation',href:null},{id:'queen',n:'04',category:'OPERATIONS / DIGITAL TRANSFORMATION',name:'Furniture Operations OS',description:'주문·견적·원가·작업 이력을 데이터로 연결하는 소규모 가구 제작 업무의 디지털 전환 기획.',roles:'Workflow Mapping · Systems Design',stack:'Data Modeling · Workflow Design',href:null}];
---
<Base title="Work — 안정빈"><section class="page-heading"><div class="section-overline">SELECTED PROJECTS / 2024 — 2026</div><h1>Work in <i>progress.</i></h1><p>조사하고, 연결하고, 설계하고, 만드는 과정의 기록.</p></section><section class="project-stack">{projects.map((p,i)=><article class="project" id={p.id}><div class="project-visual" data-index={i}><span class="project-number">{p.n} / 04</span><span class="project-monogram">{p.name.split(' ').map(s=>s[0]).join('').slice(0,3)}</span><span class="project-shape" aria-hidden="true">✳</span></div><div class="project-info"><div class="section-overline">{p.category}</div><h2>{p.name}</h2><p>{p.description}</p><dl><div><dt>FOCUS</dt><dd>{p.roles}</dd></div><div><dt>TOOLS</dt><dd>{p.stack}</dd></div></dl>{p.href?<a href={p.href} target="_blank" rel="noopener noreferrer" class="text-link">VIEW REPOSITORY ↗</a>:<span class="muted">CASE STUDY IN PREPARATION</span>}</div></article>)}</section></Base>