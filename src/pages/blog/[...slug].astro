---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Base title={post.data.title+' — 안정빈'} description={post.data.description}><article class="article-page"><a href="/blog" class="backlink">← BACK TO JOURNAL</a><div class="article-head"><div class="section-overline">{post.data.category} / <time>{post.data.published.toISOString().slice(0,10)}</time></div><h1>{post.data.title}</h1><p>{post.data.description}</p></div><div class="prose"><Content/></div><div class="article-end"><span>THANKS FOR READING.</span><a href="/blog">MORE ARTICLES ↗</a></div></article></Base>